{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lagbok Desktop",
  "version": "1.1.0",
  "identifier": "se.lagbok.desktop",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "node scripts/stage.js"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Lagbok Desktop",
        "url": "index.html",
        "width": 1100,
        "height": 820,
        "minWidth": 380,
        "minHeight": 480,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "Jonathan Lindblom",
    "copyright": "Lagtext: riksdagen.se (öppna data)",
    "category": "Productivity",
    "shortDescription": "Svensk lagtext för Windows",
    "longDescription": "Lagbok Desktop: lagar, förordningar och polisens föreskrifter med hänvisningar, sökning och snabbpanel (Ctrl + Alt + L).",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Swedish"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["lagbok"] }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg3Mzg4RjUxMTk5MTcwNkUKUldSdWNKRVpVWTg0aDRITHN0c2JGN01qZDVFYUxHSFVwNGZjMUtMV2tqU0kwSjh5UVFNa1RSVEQK",
      "endpoints": ["https://github.com/Deashi03/lagbok-desktop/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
